					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM dbo.control_table_learnIT WHERE IS_ACT_IND='Y' and source_system=@{pipeline().parameters.p_SOURCE_SYSTEM} and Load_Type=@{pipeline().parameters.p_Load_Type}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable_master",
						"type": "DatasetReference",
						"parameters": {
							"Table_name": {
								"value": " ",
								"type": "Expression"
							},
							"Schema_Name": {
								"value": " ",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
